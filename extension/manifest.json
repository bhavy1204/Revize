{
  "manifest_version": 3,
  "name": "Revize - LeetCode Tracker",
  "version": "1.0.0",
  "description": "Automatically syncs your solved LeetCode problems to your Revize account.",

  "permissions": ["storage"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content-leetcode.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["content-auth.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
